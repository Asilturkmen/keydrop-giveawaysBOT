# Windows batch files must keep CRLF line endings (labels/goto break with LF),
# also in the GitHub "Source code (zip)" download.
*.bat text eol=crlf

*.ico binary
*.png binary

# Not needed to run the bot: left out of KeydropBot.zip (and GitHub's source archives).
.github/ export-ignore
docs/ export-ignore
stats-worker/ export-ignore
.gitattributes export-ignore
